  "expectedBindings": [
    { "screenName": "Inbox", "buttonText": "Open Chat", "target": "Conversation" },
    { "screenName": "Inbox", "buttonText": "New Message", "target": "NewMessage" },
    { "screenName": "Conversation", "buttonText": "View Profile", "target": "Profile" }
