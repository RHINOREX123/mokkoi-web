{
  "functions": {
    "api/generate.ts": {
      "maxDuration": 120
    },
    "api/generate-flow.ts": {
      "maxDuration": 300
    },
    "api/create-checkout.ts": {
      "maxDuration": 30
    },
    "api/create-topup.ts": {
      "maxDuration": 30
    },
    "api/stripe-webhook.ts": {
      "maxDuration": 30
    },
    "api/analyze-diffs.ts": {
      "maxDuration": 30
    },
    "api/mcp-sync.ts": {
      "maxDuration": 15
    },
    "api/generate-image.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
