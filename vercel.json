{
  "functions": {
    "api/generate.ts": {
      "maxDuration": 120
    },
    "api/generate-flow.ts": {
      "maxDuration": 300
    },
    "api/log-edit-diff.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
