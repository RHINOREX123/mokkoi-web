# Copy to .env.local for local development (gitignored). Never commit real values.
# Production: set the same names in Vercel (site + API) and GitHub Actions secrets (report runner).

# ---------------------------------------------------------------------------
# Mokkoi X-ray
# ---------------------------------------------------------------------------

# Claude API (report engine and evals). Set a monthly spend limit in the Anthropic console.
# Where: GitHub Actions secrets (runner). Not needed on Vercel.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Supabase project for Mokkoi X-ray (orders, reports, evidence). Apply supabase/xray/*.sql to it.
# Where: Vercel (API) and GitHub Actions secrets (runner). Without these, local dev uses a
# JSON file store in .xray-data/ and Vercel refuses orders (fails closed).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Founder admin page (/admin/xray). A long random string (32+ characters); paste it into the
# admin page to sign in. Where: Vercel.
XRAY_ADMIN_TOKEN=generate-a-long-random-string

# Optional: start the runner right after "Mark paid" instead of waiting for the 10-minute cron.
# A fine-grained GitHub token with Actions: read and write on this repo. Where: Vercel.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY_SLUG=RHINOREX123/mokkoi-web
XRAY_RUNNER_REF=main

# Optional email (order received / report ready) through Resend. Where: Vercel.
RESEND_API_KEY=
XRAY_EMAIL_FROM=Mokkoi <reports@mokkoi.com>
XRAY_CONTACT_EMAIL=mokkoidev@gmail.com

# Optional: PageSpeed Insights API key (free) for higher rate limits. Where: GitHub Actions.
PAGESPEED_API_KEY=

# Site URL used in emails. Where: Vercel.
MOKKOI_PUBLIC_URL=https://mokkoi.com

# Shown on the site as the contact address.
VITE_XRAY_CONTACT_EMAIL=mokkoidev@gmail.com

# Engine tuning (defaults shown).
# XRAY_COST_CAP_USD=5          hard model-cost cap per Quick report
# XRAY_MOCK_MODEL=0            1 = offline mock model (test data only)
# XRAY_DATA_DIR=.xray-data     local file store location
# XRAY_EVAL_DIR=               folder with the private eval set (cases.json + fixtures/)
# XRAY_FIXTURE_MODE / XRAY_FIXTURE_DIR are set by the eval and collect scripts.

# ---------------------------------------------------------------------------
# Legacy mobile-builder app (kept reachable during the pivot)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_ADMIN_EMAILS=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
MOKKOI_API_KEY=
ADMIN_EMAILS=
ADMIN_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_ANNUAL=
OPENAI_API_KEY=
FAL_API_KEY=
PEXELS_API_KEY=
